# StatSkill AI - Environment Configuration
APP_NAME=StatSkill AI
ENV=development
SECRET_KEY=statskill-hackathon-2026-secret-key
DATABASE_URL=sqlite:///./statskill.db

# AI Provider Configuration (Options: mock, gemini, openai, anthropic)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL_NAME=gemini-flash-latest
AI_BASE_URL=
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.2

# Application Settings
ENABLE_OCR=true
ENABLE_HUMAN_REVIEW_MODE=true
MAX_UPLOAD_FILE_SIZE_MB=15
ALLOWED_FILE_TYPES=application/pdf,text/plain,application/vnd.ms-powerpoint
LOG_LEVEL=INFO
BACKEND_BASE_URL=http://localhost:8000
