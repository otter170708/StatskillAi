# ===================================================================
# StatSkill AI - Environment Configuration Template
# ===================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# For production, use a secrets manager (AWS Secrets Manager, HashiCorp Vault, etc.)
# ===================================================================

# -------------------------------------------------------------------
# APPLICATION CORE SETTINGS
# -------------------------------------------------------------------
# Application name (displayed in logs and API documentation)
APP_NAME=StatSkill AI

# Environment: 'development', 'staging', or 'production'
# Controls debug mode, logging verbosity, and error handling behavior
ENV=development

# Secret key for cryptographic signing (JWT tokens, sessions, etc.)
# SECURITY WARNING: Use a strong, random value in production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-in-production

# Enable debug mode (shows detailed error messages and enables reload)
# SECURITY WARNING: Never set to True in production
DEBUG=True

# -------------------------------------------------------------------
# DATABASE CONFIGURATION
# -------------------------------------------------------------------
# Database URL in SQLAlchemy format
# Examples:
#   SQLite (development):  sqlite:///./statskill.db
#   PostgreSQL (prod):     postgresql://user:password@localhost:5432/statskill
#   MySQL:                 mysql+pymysql://user:password@localhost:3306/statskill
DATABASE_URL=sqlite:///./statskill.db

# Connection pool settings for production databases
# Minimum number of connections to maintain
DB_POOL_SIZE=20

# Maximum number of connections in the pool
DB_MAX_OVERFLOW=10

# Seconds to wait before timeout on connection acquisition
DB_POOL_TIMEOUT=30

# Seconds for connection recycle (set lower for cloud databases)
DB_POOL_RECYCLE=3600

# Enable connection pool echo (logs all SQL statements when True)
# SECURITY WARNING: Disable in production as queries may contain sensitive data
DB_ECHO=False

# -------------------------------------------------------------------
# AI PROVIDER CONFIGURATION
# -------------------------------------------------------------------
# AI Provider selection: 'mock', 'gemini', 'openai', 'anthropic'
# 'mock' is useful for development and testing
AI_PROVIDER=mock

# API Key for the selected AI provider
# Gemini:   Get from https://aistudio.google.com/app/apikey
# OpenAI:   Get from https://platform.openai.com/api-keys
# Anthropic: Get from https://console.anthropic.com/
# SECURITY WARNING: Never commit this value; use environment variables in production
AI_API_KEY=your_api_key_here

# AI Model name/identifier
# Gemini:    gemini-flash-latest, gemini-pro
# OpenAI:    gpt-4, gpt-4-turbo, gpt-3.5-turbo
# Anthropic: claude-3-opus, claude-3-sonnet, claude-3-haiku
AI_MODEL_NAME=gemini-flash-latest

# Optional: Base URL for custom AI API endpoints
# Leave empty for default provider endpoints
AI_BASE_URL=

# Maximum tokens per AI API request
AI_MAX_TOKENS=2048

# Temperature for AI response generation (0.0 = deterministic, 1.0 = random)
AI_TEMPERATURE=0.2

# Request timeout in seconds for AI API calls
AI_REQUEST_TIMEOUT=30

# Maximum retries for failed AI API calls
AI_MAX_RETRIES=3

# -------------------------------------------------------------------
# FEATURE FLAGS & LIMITS
# -------------------------------------------------------------------
# Enable OCR processing for uploaded document images
ENABLE_OCR=true

# Enable human expert (SME) review workflow for AI-generated questions
ENABLE_HUMAN_REVIEW_MODE=true

# Maximum upload file size in MB
MAX_UPLOAD_FILE_SIZE_MB=15

# Allowed MIME types for file uploads (comma-separated)
ALLOWED_FILE_TYPES=application/pdf,text/plain,application/vnd.ms-powerpoint

# Number of questions generated per quiz by default
DEFAULT_NUM_QUESTIONS_PER_QUIZ=5

# Minimum confidence score (0-1) required to confirm a competency gap
MIN_CONFIDENCE_FOR_CONFIRMED_GAP=0.7

# Maximum course recommendations per identified gap
MAX_RECOMMENDATIONS_PER_GAP=2

# -------------------------------------------------------------------
# LOGGING & MONITORING
# -------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: 'json' for structured logging, 'text' for human-readable
LOG_FORMAT=text

# Enable request/response logging for all API calls
ENABLE_REQUEST_LOGGING=true

# Path to log file (leave empty to log only to console)
LOG_FILE_PATH=./logs/app.log

# Maximum size of log file before rotation (in MB)
LOG_FILE_MAX_SIZE_MB=100

# Number of backup log files to keep
LOG_FILE_BACKUP_COUNT=5

# -------------------------------------------------------------------
# SECURITY & CORS
# -------------------------------------------------------------------
# Backend API base URL (used for cross-origin requests, webhooks, etc.)
BACKEND_BASE_URL=http://localhost:8000

# Comma-separated list of allowed origins for CORS
# In production, specify exact domains: https://app.example.com,https://admin.example.com
# '*' allows all origins (NOT recommended for production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# Enable CORS credentials (cookies, authorization headers)
CORS_ALLOW_CREDENTIALS=true

# API request rate limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=60

# Enable API key authentication
ENABLE_API_KEY_AUTH=false

# -------------------------------------------------------------------
# EMAIL & NOTIFICATIONS
# -------------------------------------------------------------------
# Email service provider: 'smtp', 'sendgrid', 'aws_ses', 'mock'
EMAIL_PROVIDER=mock

# SMTP Configuration (if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=noreply@statskill-ai.gov.in

# SendGrid API Key (if EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=

# AWS SES Configuration (if EMAIL_PROVIDER=aws_ses)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email notification settings
ENABLE_EMAIL_NOTIFICATIONS=false
NOTIFICATION_EMAIL_RECIPIENT=admin@statskill-ai.gov.in

# -------------------------------------------------------------------
# CACHING & SESSION MANAGEMENT
# -------------------------------------------------------------------
# Cache provider: 'redis', 'memory', 'none'
CACHE_PROVIDER=memory

# Redis configuration (if CACHE_PROVIDER=redis)
REDIS_URL=redis://localhost:6379/0

# Session timeout in minutes
SESSION_TIMEOUT_MINUTES=30

# -------------------------------------------------------------------
# EXTERNAL SERVICE INTEGRATIONS
# -------------------------------------------------------------------
# iGOT Karmayogi Integration
IGOT_API_URL=https://api.igotKarmayogi.gov.in
IGOT_API_KEY=
IGOT_CLIENT_ID=
IGOT_CLIENT_SECRET=

# MoSPI APAR Ledger Integration
APAR_LEDGER_API_URL=https://apar.mospi.gov.in/api
APAR_LEDGER_API_KEY=

# -------------------------------------------------------------------
# FILE STORAGE
# -------------------------------------------------------------------
# Storage backend: 'local', 'aws_s3', 'gcs', 'azure_blob'
STORAGE_BACKEND=local

# Local storage directory (if STORAGE_BACKEND=local)
LOCAL_STORAGE_PATH=./uploads

# AWS S3 Configuration (if STORAGE_BACKEND=aws_s3)
AWS_S3_BUCKET=statskill-ai-uploads
AWS_S3_REGION=ap-south-1

# Google Cloud Storage Configuration (if STORAGE_BACKEND=gcs)
GCS_BUCKET=statskill-ai-uploads
GCS_PROJECT_ID=

# Azure Blob Storage Configuration (if STORAGE_BACKEND=azure_blob)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=uploads

# -------------------------------------------------------------------
# OBSERVABILITY & TRACING
# -------------------------------------------------------------------
# Tracing backend: 'jaeger', 'datadog', 'none'
TRACING_BACKEND=none

# Jaeger Configuration (if TRACING_BACKEND=jaeger)
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# Datadog Configuration (if TRACING_BACKEND=datadog)
DATADOG_API_KEY=
DATADOG_ENVIRONMENT=development

# Enable performance metrics collection
ENABLE_METRICS=false

# -------------------------------------------------------------------
# TESTING & DEVELOPMENT
# -------------------------------------------------------------------
# Use mock/stub implementations of external services
USE_MOCKS=false

# Seed database with demo data on startup
SEED_DEMO_DATA=true

# Reset database on startup (DANGEROUS - use only in development)
RESET_DATABASE_ON_STARTUP=false

# Enable API documentation endpoints (/docs, /redoc)
ENABLE_DOCS=true
